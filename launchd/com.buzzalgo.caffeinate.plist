<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.buzzalgo.caffeinate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>while true; do PID=$(docker inspect --format '{{.State.Pid}}' buzzalgo-trader-1 2>/dev/null); if [ -n "$PID" ] && [ "$PID" != "0" ]; then caffeinate -i -w "$PID"; fi; sleep 30; done</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/dougchan/ai/buzzalgo/caffeinate.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dougchan/ai/buzzalgo/caffeinate.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
